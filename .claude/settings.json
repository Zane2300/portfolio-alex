{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run preview)",
      "Bash(npm install)",
      "Bash(./deploy.sh)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Write(src/**)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Edit(astro.config.mjs)",
      "Edit(package.json)",
      "Edit(deploy.sh)"
    ],
    "deny": [
      "Read(./docs/**)",
      "Edit(./docs/**)",
      "Write(./docs/**)",
      "Read(./node_modules/**)",
      "Read(./package-lock.json)",
      "Read(./.git/**)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
