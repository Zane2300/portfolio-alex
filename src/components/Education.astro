---
import { Image } from "astro:assets";
import type {
    EducationTranslations,
    StudyItem,
    CertificationItem,
} from "../i18n/translations";

import chromeEnterpriseBadge from "../assets/certifications/chrome-enterprise-premium-badge.jpg";
import hack4uBadge from "../assets/certifications/hack4u.png";

interface Props {
    t: EducationTranslations;
}

const { t }: Props = Astro.props;

const base = import.meta.env.BASE_URL;

// Badges de emisor, cruzados por id con el diccionario. Cada uno a su tamaño natural:
// el de Google es un badge real (400px, escudo completo) y el de Hack4u un avatar de 48px.
// No se recortan a forma común ni se escala el avatar por encima de su resolución.
const badgeMap: Record<CertificationItem["id"], { src: ImageMetadata; size: string }> = {
    "chrome-enterprise": { src: chromeEnterpriseBadge, size: "h-20 w-20" },
    "linux-intro": { src: hack4uBadge, size: "h-12 w-12" },
    "linux-customization": { src: hack4uBadge, size: "h-12 w-12" },
};
---
<section id="education" class="scroll-mt-32">
    <div class="mx-auto max-w-6xl px-4 space-y-10">
        
        <!-- TITLE -->
        <header class="space-y-2">
            <h2 class="flex items-center gap-3 text-3xl md:text-4xl font-semibold">
                <svg
                    class="w-7 h-7 text-primary"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                >
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 6l8 -3l8 3l-8 3z" />
                    <path d="M4 10l8 3l8 -3" />
                    <path d="M4 14l8 3l8 -3" />
                </svg>
                {t.title}
            </h2>
        </header>

        <!-- FORMAL EDUCATION: a lo ancho -->
        <div>
            <article class="rounded-3xl border border-bg-selection bg-bg-elevated/80 shadow-[0_24px_80px_rgba(0,0,0,0.55)] p-6 md:p-8 space-y-5">
                <h3 class="text-xl font-semibold text-primary">
                    {t.formalTitle}
                </h3>
                
                <ul class="space-y-4">
                    {t.studies.map((item: StudyItem) => (
                        <li class="border-l-2 border-primary/60 pl-4">
                            <h4 class="flex flex-wrap items-center gap-2 text-base md:text-lg font-semibold">
                                {item.title}
                                {item.upcoming && (
                                    <span class="rounded-full border border-primary/40 bg-primary/15 px-2.5 py-0.5 text-xs font-semibold text-text">
                                        {t.upcomingLabel}
                                    </span>
                                )}
                            </h4>
                            <p class="text-sm">
                                {item.place} • {item.period}
                            </p>
                            <p class="mt-1 text-sm text-text-muted">
                                {item.description}
                            </p>
                        </li>
                    ))}
                </ul>
            </article>
        </div>

        <!-- CERTIFICATIONS: sección propia a lo ancho, una tarjeta por certificación -->
        <div class="space-y-5">
            <h3 class="text-xl font-semibold text-primary">
                {t.certificationsTitle}
            </h3>

            <ul class="grid gap-6 lg:grid-cols-3">
                {t.certifications.map((cert: CertificationItem) => {
                    const badge = badgeMap[cert.id];
                    return (
                        <li class="flex flex-col rounded-3xl border border-bg-selection bg-bg-elevated/80 shadow-[0_24px_80px_rgba(0,0,0,0.55)] p-6 md:p-7">
                            <div class="flex items-center gap-4 min-h-20">
                                {badge && (
                                    <Image
                                        src={badge.src}
                                        alt=""
                                        class:list={["shrink-0 object-contain", badge.size]}
                                        loading="lazy"
                                    />
                                )}
                                <h4 class="text-base md:text-lg font-semibold leading-snug">
                                    {cert.title}
                                </h4>
                            </div>

                            <p class="mt-3 text-sm">
                                {cert.place} • {cert.date}
                            </p>

                            {cert.credentialId && (
                                <p class="mt-0.5 text-xs text-text-muted">
                                    {t.credentialIdLabel}: <span class="font-mono">{cert.credentialId}</span>
                                </p>
                            )}

                            <p class="mt-2 flex-1 text-sm text-text-muted">
                                {cert.description}
                            </p>

                            <div class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2">
                                {cert.document && (
                                    <a
                                        href={`${base}${cert.document}`}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 rounded-lg text-primary hover:text-primary-light transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                                            <path d="M5 8v-3a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2h-5" />
                                            <path d="M6 14m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                                            <path d="M4.5 17l-1.5 5l3 -1.5l3 1.5l-1.5 -5" />
                                        </svg>
                                        <span>{t.viewCertificateLabel}</span>
                                    </a>
                                )}

                                {cert.verifyUrl && (
                                    <a
                                        href={cert.verifyUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="inline-flex items-center gap-2 rounded-lg text-primary hover:text-primary-light transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
                                    >
                                        <svg
                                            class="w-4 h-4"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                            <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                                            <path d="M9 12l2 2l4 -4" />
                                        </svg>
                                        <span>{t.verifyLabel}</span>
                                    </a>
                                )}
                            </div>
                        </li>
                    );
                })}
            </ul>
        </div>
    </div>
</section>
