---
import { Image } from "astro:assets";
import type { SkillsTranslations, SoftSkillKey } from "../i18n/translations";

import kalilinuxLogo from "../assets/tech/kali-linux.png";
import nmapLogo from "../assets/tech/nmap.png";
import burpsuiteLogo from "../assets/tech/burpsuite.png";
import metasploitLogo from "../assets/tech/metasploit.png";
import wiresharkLogo from "../assets/tech/wireshark.png";

import adLogo from "../assets/tech/active-directory.png";
import fortinetLogo from "../assets/tech/fortinet.png";
import linuxLogo from "../assets/tech/linux.png";
import arubaLogo from "../assets/tech/aruba.png";
import vmwareLogo from "../assets/tech/vmware.svg";

import dockerLogo from "../assets/tech/docker.png";
import ansibleLogo from "../assets/tech/ansible.png";
import pythonLogo from "../assets/tech/python.png";
import shellLogo from "../assets/tech/shell.png";
import n8nLogo from "../assets/tech/n8n.svg";

interface Props {
    t: SkillsTranslations;
}

const { t }: Props = Astro.props;

// Secciones técnicas: aquí sólo definimos la estructura y los logos.
// Los títulos y descripciones vienen del diccionario (t.sections), enlazados por "key".
// `chip: true` = logo monocromo oscuro que necesita fondo claro fijo para leerse
// en tema oscuro (ver token --color-logo-chip en global.css).
const sections = [
    {
        key: "security",
        items: [
            { name: "Kali Linux", logo: kalilinuxLogo },
            { name: "Nmap", logo: nmapLogo },
            { name: "Burp Suite", logo: burpsuiteLogo },
            { name: "Metasploit", logo: metasploitLogo },
            { name: "Wireshark", logo: wiresharkLogo },
        ],
    },
    {
        key: "systems",
        items: [
            { name: "Active Directory", logo: adLogo },
            { name: "Fortinet", logo: fortinetLogo },
            { name: "Linux", logo: linuxLogo },
            { name: "Aruba switches", logo: arubaLogo },
            { name: "VMware", logo: vmwareLogo, chip: true },
        ],
    },
    {
        key: "automation",
        items: [
            { name: "Docker", logo: dockerLogo },
            { name: "Ansible", logo: ansibleLogo },
            { name: "Python", logo: pythonLogo },
            { name: "Bash / Shell", logo: shellLogo, chip: true },
            { name: "n8n", logo: n8nLogo },
        ],
    },
];

// Iconos de competencias personales (Tabler, stroke 1.5, currentColor), cruzados por key
// con el diccionario. Criterio: si un icono podría ilustrar cualquier otra de las cinco,
// no entra. Si alguna se queda sin icono, se deja el hueco antes que meter relleno.
const svgAttrs = `viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6"`;

const softSkillIcons: Partial<Record<SoftSkillKey, string>> = {
    mentoring: `<svg ${svgAttrs}><path d="M22 9l-10 -4l-10 4l10 4l10 -4v6" /><path d="M6 10.6v5.4a6 3 0 0 0 12 0v-5.4" /></svg>`,
    communication: `<svg ${svgAttrs}><path d="M8 9h8" /><path d="M8 13h6" /><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z" /></svg>`,
    incidents: `<svg ${svgAttrs}><path d="M3 12h4l3 8l4 -16l3 8h4" /></svg>`,
    diagnosis: `<svg ${svgAttrs}><path d="M7 10h3v-3l-3.5 -3.5a6 6 0 0 1 8 8l6 6a2 2 0 0 1 -3 3l-6 -6a6 6 0 0 1 -8 -8l3.5 3.5" /></svg>`,
    selfTaught: `<svg ${svgAttrs}><path d="M5 7l5 5l-5 5" /><path d="M12 19h7" /></svg>`,
};

// Unimos secciones base + textos de traducción según la key
const sectionsWithText = sections.map((section) => {
    const text = t.sections.find((s) => s.key === section.key) ?? {
        title: "",
        description: "",
    };
    return {
        ...section,
        title: text.title,
        description: text.description,
    };
});
---
<section id="skills" class="scroll-mt-32">
    <header class="mb-10">
        <h2 class="flex items-center gap-3 text-3xl md:text-4xl font-semibold">
            <svg
                class="w-6 h-6 text-primary"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M5 9l14 0" />
                <path d="M5 15l14 0" />
                <path d="M11 4l-4 16" />
                <path d="M17 4l-4 16" />
            </svg>
            {t.title}
        </h2>
    </header>

    {/* BENTO GRID: 3 tarjetas técnicas + idiomas en el cuarto hueco */}
    <div class="grid gap-6 md:grid-cols-2">
        {sectionsWithText.map((section: any) => (
            <article class="rounded-3xl border border-bg-selection bg-bg-elevated/80 p-6 md:p-8 shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
                <h3 class="text-lg md:text-xl font-semibold text-primary mb-1">
                    {section.title}
                </h3>
                <p class="text-sm text-text-muted mb-4">
                    {section.description}
                </p>

                <ul class="grid grid-cols-3 sm:grid-cols-5 md:grid-cols-3 lg:grid-cols-5 gap-3">
                    {section.items.map((item: any) => (
                        <li class="flex flex-col items-center gap-2">
                            <div class:list={[
                                "flex h-16 w-16 items-center justify-center rounded-2xl border border-bg-selection shadow-[0_14px_40px_rgba(0,0,0,0.45)]",
                                item.chip ? "bg-logo-chip" : "bg-bg-dark/80",
                            ]}>
                                <Image src={item.logo} alt={item.name} class="h-9 w-9 object-contain" loading="lazy" />
                            </div>
                            <span class="text-xs text-text-muted text-center">
                                {item.name}
                            </span>
                        </li>
                    ))}
                </ul>
            </article>
        ))}

        {/* IDIOMAS: mismo nivel del grid, tratamiento distinto — no es competencia técnica */}
        <article class="rounded-3xl border border-bg-selection bg-bg-elevated/50 p-6 md:p-8 shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
            <h3 class="text-lg md:text-xl font-semibold text-primary mb-4">
                {t.languagesTitle}
            </h3>

            <ul class="flex flex-wrap gap-3">
                {t.languages.map((lang) => (
                    <li
                        class="inline-flex items-center gap-2 rounded-full border border-bg-selection bg-bg-dark/40 py-1.5 pl-4 pr-1.5"
                        aria-label={`${lang.name}: ${lang.level}`}
                    >
                        <span class="text-sm text-text-muted">{lang.name}</span>
                        {/* El acento va en el borde y el fondo, no en el texto: `text-primary`
                            sobre `bg-primary/15` no llega a 4,5:1 en ninguno de los dos temas. */}
                        <span class="rounded-full border border-primary/40 bg-primary/15 px-2.5 py-0.5 text-xs font-semibold text-text">
                            {lang.level}
                        </span>
                    </li>
                ))}
            </ul>
        </article>
    </div>

    {/* SOFT SKILLS: a lo ancho, bajo el grid */}
    <article class="mt-6 rounded-3xl border border-bg-selection bg-bg-elevated/80 p-6 md:p-8 shadow-[0_24px_80px_rgba(0,0,0,0.55)]">
        <h3 class="text-lg md:text-xl font-semibold text-primary mb-4">
            {t.softSkillsTitle}
        </h3>
        <ul class="grid gap-4 sm:grid-cols-2 text-text">
            {t.softSkills.map((skill) => (
                <li class="flex items-start gap-3">
                    <span class="mt-0.5 w-6 shrink-0 text-primary" aria-hidden="true">
                        <Fragment set:html={softSkillIcons[skill.key] ?? ""} />
                    </span>
                    <p class="text-base leading-snug">
                        {skill.text}
                    </p>
                </li>
            ))}
        </ul>
    </article>
</section>
